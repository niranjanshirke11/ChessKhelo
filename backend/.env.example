# ============================================================
# ChessKhelo — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values before running.
# NO DATABASE REQUIRED — all data is stored in server memory.
# ============================================================

# Port for the backend server
PORT=5000

# Node environment (development | production)
NODE_ENV=development

# JWT Secret — change this to any long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-in-production

# JWT expiry (how long login tokens last)
JWT_EXPIRES_IN=7d

# URL of your frontend (used for CORS)
# Local dev: http://localhost:5173
# AWS production: https://your-cloudfront-or-s3-url.com
FRONTEND_URL=http://localhost:5173
