# ── Server Configuration ──────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB Atlas ───────────────────────────────────────────────
# Sign up at https://cloud.mongodb.com -> Create free M0 cluster -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/chesskhelo?retryWrites=true&w=majority

# ── JWT Authentication Secrets ──────────────────────────────────
# Generate 64-char random hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_random_hex_characters_for_jwt_signing
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_64_random_hex_characters_for_refresh
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS Whitelist ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

